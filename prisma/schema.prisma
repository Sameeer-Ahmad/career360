// MongoDB schema — active application schema as of the MySQL -> MongoDB
// cutover. Field-for-field identical to the validated candidate schema at
// mongo-migration/prisma/schema.prisma (dry-run migration + 11/11
// validation passed against both the scratch and real career360
// databases before this file was adopted). MySQL is retained temporarily
// as a rollback/reference database — see mongo-migration/prisma-mysql-snapshot/
// for its frozen schema and mongo-migration/scripts/ for the migration
// tooling, both left fully intact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified DateTime?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  applications Application[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  website   String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]

  @@index([name])
}

model Application {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  userId         String            @db.ObjectId
  companyId      String            @db.ObjectId
  jobTitle       String
  jobUrl         String?
  location       String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  employmentType EmploymentType?
  appliedAt      DateTime?
  status         ApplicationStatus @default(WISHLIST)
  jobDescription String?
  priority       Priority?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([companyId])
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
